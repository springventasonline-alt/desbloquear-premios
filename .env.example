# Servidor
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Tiendanube OAuth (App ID: 33285)
TIENDANUBE_APP_ID=33285
TIENDANUBE_CLIENT_SECRET=tu_client_secret_del_partner_portal
TIENDANUBE_REDIRECT_URI=http://localhost:3000/auth/callback
TIENDANUBE_API_VERSION=2025-03
TIENDANUBE_USER_AGENT=DesbloquearPremios (paloma@example.com)

# Script de Tiendanube (registrar en Partner Portal)
TIENDANUBE_SCRIPT_ID=

# PostgreSQL (solo local; en Railway usar DATABASE_URL=${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/desbloquear_premios
